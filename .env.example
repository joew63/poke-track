# Copy this file to .env and fill in the values you need.
# A notifier only activates once all of its required variables are set.

# Best Buy official Products API — free instant signup at https://developer.bestbuy.com/
BESTBUY_API_KEY=

# Discord notifications — Server Settings > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Email notifications via SMTP (works with a Gmail address + App Password:
# https://myaccount.google.com/apppasswords — requires 2-Step Verification enabled)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_TO=
